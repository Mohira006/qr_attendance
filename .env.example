# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=development
DEBUG=false
FRONTEND_URL=http://localhost:5173

# Database
# Local development against the docker-compose PostgreSQL:
DATABASE_URL=postgresql+asyncpg://attendance:attendance@localhost:5432/attendance
# Tests and quick local runs can use SQLite instead:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_ECHO=false

# Authentication (JWT_SECRET: random string, minimum 16 characters; use 32+ in production)
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Company defaults (company name is only used to initialise the settings row; HR edits it in the UI)
COMPANY_NAME=Demo Company
# IANA timezone in which working hours are defined and scans are interpreted
COMPANY_TIMEZONE=Asia/Tashkent

# File storage for profile photos, generated PDFs, and uploaded explanation
# letter attachments (relative to the backend working directory)
STORAGE_PATH=./storage
MAX_PHOTO_SIZE_BYTES=2097152
MAX_LETTER_ATTACHMENT_SIZE_BYTES=5242880

# Seed script (development only)
SEED_PASSWORD=Password123!

# PostgreSQL container (docker-compose)
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance
POSTGRES_DB=attendance
